<Project Sdk="Microsoft.NET.Sdk">
  <!-- Benchmark support: reset the database to the fixed seed, and fingerprint it so a run can PROVE every target
       measured identical data. Not part of the product. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DbTool</AssemblyName>
    <RootNamespace>ConfReg.Bench.DbTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
