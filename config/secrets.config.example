<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to  src/Legacy.Web/secrets.config  and  src/Legacy.Service/secrets.config  (both are git-ignored).
  Pulled in by <appSettings file="secrets.config"> in Web.config / App.config.

  Every environment variable ConfReg__<Name> overrides the same key here (containers, CI, IIS app-pool env),
  and Modern.Web / Jobs.Worker read the SAME names through IOptions, so one set of env vars serves every host.

  EVERY VALUE BELOW IS A MADE-UP DEMO PLACEHOLDER. Replace all of them for anything real.
  LegacyCryptoKey/Iv are the demo values the Phase 2 characterization seed was encrypted with. Keep them as-is
  for the tests; a real deployment uses its own key, which must be the key its existing rows were written with.
-->
<appSettings>
  <add key="ConfReg:ConnectionString" value="Server=localhost,1433;Database=ConfReg;User Id=sa;Password=ConfReg_Dev_Passw0rd!;TrustServerCertificate=True;" />
  <add key="ConfReg:PaymentApiKey" value="sk_test_DEMO_not_a_real_key" />
  <add key="ConfReg:LegacyCryptoKey" value="Y29uZnJlZy1kZW1vLWtleS1OT1QtQS1TRUNSRVQtMDA=" />
  <add key="ConfReg:LegacyCryptoIv" value="Y29uZnJlZy1kZW1vLWl2IQ==" />
</appSettings>
