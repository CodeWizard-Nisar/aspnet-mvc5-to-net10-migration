{
  "Urls": "http://localhost:5090",

  "ConfReg": {
    "HoldMinutes": 30
  },

  "Jobs": {
    "ExpireCron": "0 * * * * ?",
    "ConfirmationEmailCron": "0 0/5 * * * ?",
