<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ConfReg.Gateway: the single front door (YARP reverse proxy). The browser only ever talks to this. Per page, configuration
    decides whether the request goes to Legacy.Web (.NET Framework 4.8) or Modern.Web (.NET 10). Moving a page across, or back,
    is a configuration change, not a deployment: that is what makes the migration incremental and reversible.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ConfReg.Gateway</RootNamespace>
    <AssemblyName>ConfReg.Gateway</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
