<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Phase 1: net48 only. Phase 3 multi-targets this to net48;net10.0. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ConfReg.Domain</RootNamespace>
    <AssemblyName>ConfReg.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- BASELINE-PROBLEM #1: a "domain" library that references System.Web.
         This reference is the thing that stops this project from ever loading on .NET 10. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
  </ItemGroup>

</Project>
