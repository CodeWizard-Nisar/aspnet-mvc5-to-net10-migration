@model LoginForm
@{ ViewBag.Title = "Admin login"; }
<h1>Admin login</h1>
@await Html.PartialAsync("_Errors", Model.Errors)
<form method="post" action="@Url.Action("Login", "Account")">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <div class="mb-3"><label class="form-label">Email</label><input class="form-control" name="Email" value="@Model.Email" /></div>
    <div class="mb-3"><label class="form-label">Password</label><input class="form-control" type="password" name="Password" /></div>
    <button class="btn btn-primary" type="submit">Log in</button>
</form>
