<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- BASELINE-PROBLEM #4: second copy of the plain-text connection string (see Legacy.Web/Web.config).
         Two files to keep in step, both holding a credential. Throwaway local-dev value matching .env.example. -->
    <add name="ConfReg"
         connectionString="Server=localhost,1433;Database=ConfReg;User Id=sa;Password=ConfReg_Dev_Passw0rd!;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Registration.HoldMinutes" value="30" />
    <add key="Service.IntervalSeconds" value="60" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
