<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Phase 3: no secrets here (BASELINE-PROBLEM #4, fixed; this was the second copy of the plain-text connection
       string). secrets.config sits next to the exe and is git-ignored: copy config/secrets.config.example. -->
  <appSettings file="secrets.config">
    <add key="ConfReg:HoldMinutes" value="30" />
    <add key="Service.IntervalSeconds" value="60" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
