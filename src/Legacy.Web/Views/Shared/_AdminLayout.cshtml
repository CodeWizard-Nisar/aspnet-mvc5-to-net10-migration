@{
    // BASELINE-PROBLEM #6: the ENTIRE admin authentication check, in a layout file.
    //
    // Why this is wrong:
    //  - A layout runs only while a view renders. Controller actions that return a redirect, a file (CSV export)
    //    or JSON never get here, so they are completely unprotected.
    //  - Response.Redirect ends the response by throwing ThreadAbortException. It is slow and fragile.
    //  - Security logic buried in presentation is invisible to anyone reading the controllers.
    //  - There is no role check: "Staff" can do everything "Admin" can.
    // Fixed in Phase 5: cookie authentication plus a global authorize filter on the modern side.
    if (Session["AdminUserId"] == null)
    {
        Response.Redirect("~/Account/Login?returnUrl=" + HttpUtility.UrlEncode(Request.RawUrl));
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - ConfReg Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-secondary mb-4"><div class="container">
    <span class="navbar-brand">ConfReg Admin</span>
    <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Admin")">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Attendees")">Attendees</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Talks")">Talks</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Registrations")">Registrations</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Admin/Settings")">Settings</a></li>
    </ul>
    <span class="navbar-text me-3">@Session["AdminEmail"]</span>
    <a class="btn btn-sm btn-outline-light" href="@Url.Content("~/Account/Logout")">Log out</a>
</div></nav>
<div class="container">@RenderBody()</div>
</body>
</html>
