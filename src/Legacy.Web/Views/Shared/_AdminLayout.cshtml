@* BASELINE-PROBLEM #6, fixed in Phase 5: the login check that lived here (a Response.Redirect) is gone. A layout only runs
   when a view renders, so it never protected redirecting POSTs, file downloads or JSON. AdminAuthorizeFilter, a global
   filter, now guards every action. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - ConfReg Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-secondary mb-4"><div class="container">
    <span class="navbar-brand">ConfReg Admin</span>
    <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Admin")">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Attendees")">Attendees</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Talks")">Talks</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Registrations")">Registrations</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Content("~/Admin/Settings")">Settings</a></li>
    </ul>
    <span class="navbar-text me-3">@Session[ConfReg.Domain.Wizard.SessionKeys.AdminEmail]</span>
    <a class="btn btn-sm btn-outline-light" href="@Url.Content("~/Account/Logout")">Log out</a>
</div></nav>
<div class="container">@RenderBody()</div>
</body>
</html>
