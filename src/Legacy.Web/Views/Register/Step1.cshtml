@model Step1Form
@{ ViewBag.Title = "Step 1 of 4: Your details"; }
<h1>Step 1 of 4: Your details</h1>
@if (!string.IsNullOrEmpty(Model.Notice)) { <div class="alert alert-warning">@Model.Notice</div> }
@Html.Partial("_Errors", Model.Errors)
@using (Html.BeginForm("Step1", "Register", FormMethod.Post))
{
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">First name</label><input class="form-control" name="FirstName" value="@Model.FirstName" /></div>
        <div class="col-md-6"><label class="form-label">Last name</label><input class="form-control" name="LastName" value="@Model.LastName" /></div>
        <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" name="Email" value="@Model.Email" /></div>
        <div class="col-md-6"><label class="form-label">Company</label><input class="form-control" name="Company" value="@Model.Company" /></div>
        <div class="col-md-6"><label class="form-label">Job title</label><input class="form-control" name="JobTitle" value="@Model.JobTitle" /></div>
        <div class="col-md-6"><label class="form-label">Dietary requirements</label><input class="form-control" name="DietaryRequirements" value="@Model.DietaryRequirements" /></div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Next: choose a ticket</button>
}
